<Layout xmlns="urn:speedata.de:2009/publisher/en"
    xmlns:sd="urn:speedata:2009/publisher/functions/en">

    <Record element="data">
        <PlaceObject>
            <Textblock width="3">
                <!-- no special character: line break after "fox" -->
                <Paragraph>
                    <Value>The quick brown fox jumps over the lazy dog.</Value>
                </Paragraph>
                <!-- U+0083 NO BREAK HERE keeps "foxjumps" together -->
                <Paragraph>
                    <Value>The quick brown fox&#131;jumps over the lazy dog.</Value>
                </Paragraph>
                <!-- U+2060 WORD JOINER makes the following space unbreakable -->
                <Paragraph>
                    <Value>The quick brown fox&#8288; jumps over the lazy dog.</Value>
                </Paragraph>
            </Textblock>
        </PlaceObject>
    </Record>
</Layout>
