<Layout xmlns="urn:speedata.de:2009/publisher/en"
    xmlns:sd="urn:speedata:2009/publisher/functions/en">
    <Pageformat height="5cm" width="5cm" />
    <Options bleed="5mm" cutmarks="yes"/>
    <Record element="data">
        <PlaceObject row="0mm" column="0mm">
            <Box height="1cm" width="1cm" background-color="green" bleed="auto"/>
        </PlaceObject>
        <PlaceObject row="0mm" column="40mm">
            <Box height="1cm" width="1cm" background-color="green" bleed="auto"/>
        </PlaceObject>
        <PlaceObject row="40mm" column="0mm">
            <Box height="1cm" width="1cm" background-color="green" bleed="auto"/>
        </PlaceObject>
        <PlaceObject row="40mm" column="40mm">
            <Box height="1cm" width="1cm" background-color="green" bleed="auto"/>
        </PlaceObject>
    </Record>
</Layout>