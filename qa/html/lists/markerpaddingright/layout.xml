<Layout xmlns="urn:speedata.de:2009/publisher/en"
    xmlns:sd="urn:speedata:2009/publisher/functions/en">
    <Pageformat height="10cm" width="8cm"  />
    <Stylesheet>
        ul { padding-left:6pt; }
        li::marker { padding-right: 1pt; }
    </Stylesheet>
    <Record element="data">
        <PlaceObject>
            <Textblock>
                <Paragraph>
                    <Value select="sd:decode-html(.)"></Value>
                </Paragraph>
            </Textblock>
        </PlaceObject>
    </Record>
</Layout>