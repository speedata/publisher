<Layout xmlns="urn:speedata.de:2009/publisher/en"
	xmlns:sd="urn:speedata:2009/publisher/functions/en">
	<Pageformat height="3cm" width="4cm"></Pageformat>

	<DefineTextformat name="indent" indentation="4mm" rows="-1" margin-top="0pt"  />

	<Stylesheet>
		small { font-size: 8pt; font-family-number: 0; }
	</Stylesheet>

	<Record element="data">
		<PlaceObject>
			<Textblock>
				<Paragraph textformat="indent" html="all">
					<Value>•&#xA0;&#xA0;&#xA0;</Value>
					<Value select="li" />
				</Paragraph>
			</Textblock>
		</PlaceObject>
	</Record>
</Layout>