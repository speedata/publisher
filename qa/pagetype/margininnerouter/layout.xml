<Layout xmlns="urn:speedata.de:2009/publisher/en"
    xmlns:sd="urn:speedata:2009/publisher/functions/en">
    <Pagetype name="t" test="true()">
        <Margin inner="4cm" outer="1cm" top="2cm" bottom="2cm" />
    </Pagetype>

    <Pageformat height="6cm" width="8cm"></Pageformat>
    <Record element="data">
        <Loop select="3">
            <PlaceObject>
                <Textblock>
                    <Paragraph>
                        <Value>Hello world</Value>
                    </Paragraph>
                </Textblock>
            </PlaceObject>
            <ClearPage />
        </Loop>
    </Record>
</Layout>