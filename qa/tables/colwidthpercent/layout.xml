<?xml version="1.0" encoding="UTF-8"?>
<Layout xmlns="urn:speedata.de:2009/publisher/en"
  xmlns:sd="urn:speedata:2009/publisher/functions/en">

  <Options />
  <SetGrid width="5mm" height="4mm"/>
  <Pageformat width="12cm" height="9cm"/>
  <Pagetype name="p" test="true()">
    <Margin left="1cm" right="1cm" top="1cm" bottom="1cm"/>
  </Pagetype>

  <Record element="data">
    <!-- percentages only -->
    <PlaceObject>
      <Table width="10cm" stretch="max">
        <Columns>
          <Column width="25%"/>
          <Column width="25%"/>
          <Column width="50%"/>
        </Columns>
        <Tr><Td border-left="0.5pt" border-right="0.5pt"><Paragraph><Value>25%</Value></Paragraph></Td>
          <Td border-right="0.5pt"><Paragraph><Value>25%</Value></Paragraph></Td>
          <Td border-right="0.5pt"><Paragraph><Value>50%</Value></Paragraph></Td></Tr>
      </Table>
    </PlaceObject>

    <!-- percentages with column distance: 2cm + 8cm - 0.5cm = 9.5cm -->
    <PlaceObject>
      <Table width="10cm" stretch="max" columndistance="5mm">
        <Columns>
          <Column width="20%"/>
          <Column width="80%"/>
        </Columns>
        <Tr><Td border-left="0.5pt" border-right="0.5pt"><Paragraph><Value>20%</Value></Paragraph></Td>
          <Td border-left="0.5pt" border-right="0.5pt"><Paragraph><Value>80%</Value></Paragraph></Td></Tr>
      </Table>
    </PlaceObject>

    <!-- percentage, fixed and star: 3cm + 2cm, rest (5cm) for the star -->
    <PlaceObject>
      <Table width="10cm" stretch="max">
        <Columns>
          <Column width="30%"/>
          <Column width="2cm"/>
          <Column width="*"/>
        </Columns>
        <Tr><Td border-left="0.5pt" border-right="0.5pt"><Paragraph><Value>30%</Value></Paragraph></Td>
          <Td border-right="0.5pt"><Paragraph><Value>2cm</Value></Paragraph></Td>
          <Td border-right="0.5pt"><Paragraph><Value>*</Value></Paragraph></Td></Tr>
      </Table>
    </PlaceObject>

    <!-- decimal stars: 2cm, 5cm (2.5*) and 3cm (1.5*) -->
    <PlaceObject>
      <Table width="10cm" stretch="max">
        <Columns>
          <Column width="*"/>
          <Column width="2.5*"/>
          <Column width="1.5*"/>
        </Columns>
        <Tr><Td border-left="0.5pt" border-right="0.5pt"><Paragraph><Value>*</Value></Paragraph></Td>
          <Td border-right="0.5pt"><Paragraph><Value>2.5*</Value></Paragraph></Td>
          <Td border-right="0.5pt"><Paragraph><Value>1.5*</Value></Paragraph></Td></Tr>
      </Table>
    </PlaceObject>

    <!-- percentages with stretch="no": the table is 6cm wide -->
    <PlaceObject>
      <Table width="10cm">
        <Columns>
          <Column width="40%"/>
          <Column width="20%"/>
        </Columns>
        <Tr><Td border-left="0.5pt" border-right="0.5pt"><Paragraph><Value>40%</Value></Paragraph></Td>
          <Td border-right="0.5pt"><Paragraph><Value>20%</Value></Paragraph></Td></Tr>
      </Table>
    </PlaceObject>
  </Record>
</Layout>
