<Layout
	xmlns="urn:speedata.de:2009/publisher/en"
	xmlns:sd="urn:speedata:2009/publisher/functions/en">

	<SetGrid nx="12" ny="12" dx="6mm" dy="6mm" />

	<Pagetype name="page" test="true()">
		<Margin left="20mm" right="12mm" top="50mm" bottom="30mm" />
	</Pagetype>

	<Record element="data">
		<PlaceObject>
			<Table stretch="max" >
				<ForAll select="entry">
					<Tr>
						<Td>
							<Loop select="@count">
								<Paragraph><Value>AAA</Value></Paragraph>
							</Loop>
						</Td>
					</Tr>
				</ForAll>
				<Tablefoot page="last">
					<Tr>
						<Td>
							<VSpace height="60pt" />
							<Paragraph><Value>Tablefoot last page</Value></Paragraph>
						</Td>
					</Tr>
				</Tablefoot>
			</Table>
		</PlaceObject>
	</Record>
</Layout>