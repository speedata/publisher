<Layout xmlns="urn:speedata.de:2009/publisher/en"
    xmlns:sd="urn:speedata:2009/publisher/functions/en">

    <Pageformat width="120mm" height="200mm"/>
    <DefineColor name="darkblue" model="rgb" r="20" g="40" b="120"/>
    <LoadFontfile name="lmmath" filename="latinmodern-math.otf"/>
    <DefineFontfamily name="lmmath" fontsize="10" leading="12">
        <Regular fontface="lmmath"/>
    </DefineFontfamily>
    <DefineFontfamily name="display" fontsize="10" leading="30">
        <Regular fontface="lmmath"/>
    </DefineFontfamily>

    <Record element="data">
        <PlaceObject>
            <Textblock>
                <Paragraph>
                    <Value>Inline: Pythagoras </Value>
                    <Math fontfamily="lmmath">
                        <msup><mi>a</mi><mn>2</mn></msup>
                        <mo>+</mo>
                        <msup><mi>b</mi><mn>2</mn></msup>
                        <mo>=</mo>
                        <msup><mi>c</mi><mn>2</mn></msup>
                    </Math>
                    <Value>, derivative </Value>
                    <Math>
                        <msup><mi>f</mi><mo>′</mo></msup>
                        <mo>(</mo><mi>x</mi><mo>)</mo>
                        <mo>=</mo>
                        <mn>2</mn><mi>x</mi>
                    </Math>
                    <Value>, sum </Value>
                    <Math>
                        <munderover><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover>
                        <mi>k</mi>
                        <mo>=</mo>
                        <mfrac><mrow><mi>n</mi><mo>(</mo><mi>n</mi><mo>+</mo><mn>1</mn><mo>)</mo></mrow><mn>2</mn></mfrac>
                    </Math>
                    <Value>, relations </Value>
                    <Math>
                        <mi>a</mi><mo>≤</mo><mi>b</mi><mo>≠</mo><mi>c</mi><mo>∈</mo><mi>M</mi><mo>,</mo>
                        <mi>x</mi><mo>∘</mo><mi>y</mi><mo>∪</mo><mi>z</mi>
                    </Math>
                    <Value> in running text.</Value>
                </Paragraph>

                <Paragraph fontfamily="display">
                    <Math display="yes">
                        <munderover><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover>
                        <msup><mi>k</mi><mn>2</mn></msup>
                        <mo>=</mo>
                        <mfrac>
                            <mrow><mi>n</mi><mo>(</mo><mi>n</mi><mo>+</mo><mn>1</mn><mo>)</mo><mo>(</mo><mn>2</mn><mi>n</mi><mo>+</mo><mn>1</mn><mo>)</mo></mrow>
                            <mn>6</mn>
                        </mfrac>
                    </Math>
                </Paragraph>

                <Paragraph fontfamily="display">
                    <Math display="yes">
                        <msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup>
                        <msup><mi>x</mi><mn>2</mn></msup>
                        <mi>d</mi><mi>x</mi>
                        <mo>=</mo>
                        <mfrac><mn>1</mn><mn>3</mn></mfrac>
                        <mo>,</mo>
                        <munderover><mo>∫</mo><mi>a</mi><mi>b</mi></munderover>
                        <mi>f</mi>
                    </Math>
                </Paragraph>

                <Paragraph fontfamily="display">
                    <Math display="yes">
                        <munder><mi>lim</mi><mrow><mi>x</mi><mo>→</mo><mn>0</mn></mrow></munder>
                        <mfrac><mrow><mi>sin</mi><mi>x</mi></mrow><mi>x</mi></mfrac>
                        <mo>=</mo>
                        <mn>1</mn>
                        <mo>,</mo>
                        <mi>a</mi>
                        <mover><mo>=</mo><mi>def</mi></mover>
                        <mi>b</mi>
                    </Math>
                </Paragraph>

                <Paragraph fontfamily="display">
                    <Math display="yes">
                        <mover><mi>v</mi><mo>→</mo></mover>
                        <mo>+</mo>
                        <mover><mi>x</mi><mo>^</mo></mover>
                        <mo>+</mo>
                        <mover><mi>y</mi><mo>¯</mo></mover>
                        <mo>+</mo>
                        <mover accent="true"><mi>z</mi><mo>~</mo></mover>
                        <mo>+</mo>
                        <munder><mi>w</mi><mo>̲</mo></munder>
                        <mo>,</mo>
                        <msubsup><mi>f</mi><mn>1</mn><mo>″</mo></msubsup>
                    </Math>
                </Paragraph>

                <Paragraph fontfamily="display">
                    <Math display="yes">
                        <mi>x</mi><mo>=</mo>
                        <mfrac>
                            <mrow><mo>-</mo><mi>b</mi><mo>±</mo><msqrt><msup><mi>b</mi><mn>2</mn></msup><mo>-</mo><mn>4</mn><mi>a</mi><mi>c</mi></msqrt></mrow>
                            <mrow><mn>2</mn><mi>a</mi></mrow>
                        </mfrac>
                    </Math>
                </Paragraph>

                <Paragraph fontfamily="display" color="darkblue" id="colortest">
                    <Math display="yes">
                        <mroot><mrow><mi>x</mi><mo>+</mo><mn>1</mn></mrow><mn>3</mn></mroot>
                        <mo>,</mo>
                        <mrow><mo>(</mo><mfrac linethickness="0"><mi>n</mi><mi>k</mi></mfrac><mo>)</mo></mrow>
                        <mo>=</mo>
                        <mfrac><mrow><mi>n</mi><mo>!</mo></mrow><mrow><mi>k</mi><mo>!</mo><mo>(</mo><mi>n</mi><mo>-</mo><mi>k</mi><mo>)</mo><mo>!</mo></mrow></mfrac>
                        <mo>,</mo>
                        <mi>α</mi><mo>+</mo><mi>β</mi><mo>=</mo><mi>Γ</mi><mo>,</mo>
                        <mfrac><mrow><mo>∂</mo><mi>f</mi></mrow><mrow><mo>∂</mo><mi>x</mi></mrow></mfrac>
                        <mspace width="1em"/>
                        <mi mathvariant="normal">d</mi><mi>x</mi>
                        <mo>,</mo>
                        <msup><mi mathvariant="normal">e</mi><mrow><mi mathvariant="normal">i</mi><mi>π</mi></mrow></msup>
                    </Math>
                </Paragraph>

                <Paragraph fontfamily="display">
                    <Math display="yes">
                        <msqrt><mfrac><mfrac><mi>a</mi><mi>b</mi></mfrac><mfrac><mi>c</mi><mi>d</mi></mfrac></mfrac></msqrt>
                        <mo>+</mo>
                        <msqrt><mfrac><mfrac><mfrac><mi>a</mi><mi>b</mi></mfrac><mi>b</mi></mfrac><mfrac><mi>c</mi><mfrac><mi>c</mi><mi>d</mi></mfrac></mfrac></mfrac></msqrt>
                        <mo>+</mo>
                        <mover><mrow><mi>a</mi><mi>b</mi><mi>c</mi></mrow><mo>→</mo></mover>
                        <mo>+</mo>
                        <mover><mrow><mi>a</mi><mo>+</mo><mi>b</mi><mo>+</mo><mi>c</mi><mo>+</mo><mi>d</mi></mrow><mo>→</mo></mover>
                        <mo>+</mo>
                        <mover><mrow><mi>x</mi><mi>y</mi><mi>z</mi></mrow><mo>^</mo></mover>
                    </Math>
                </Paragraph>

                <Paragraph fontfamily="display">
                    <Math display="yes">
                        <mrow><mo>[</mo><mfrac><mfrac><mi>a</mi><mi>b</mi></mfrac><mi>c</mi></mfrac><mo>]</mo></mrow>
                        <mo>+</mo>
                        <msup><mrow><mo>(</mo><mi>a</mi><mo>+</mo><mfrac><mi>b</mi><mi>c</mi></mfrac><mo>)</mo></mrow><mn>2</mn></msup>
                        <mo>+</mo>
                        <mrow><mo>{</mo><mi>x</mi><mo>|</mo><mfrac><mi>x</mi><mn>2</mn></mfrac><mo>&gt;</mo><mn>0</mn><mo>}</mo></mrow>
                        <mo>+</mo>
                        <mrow><mo stretchy="false">(</mo><mfrac><mi>a</mi><mi>b</mi></mfrac><mo stretchy="false">)</mo></mrow>
                    </Math>
                </Paragraph>

                <Paragraph>
                    <Value>Inline with mstyle: </Value>
                    <Math>
                        <mstyle displaystyle="true">
                            <mfrac><mn>1</mn><mn>2</mn></mfrac>
                        </mstyle>
                        <mo>+</mo>
                        <mfrac><mn>1</mn><mn>2</mn></mfrac>
                        <mo>+</mo>
                        <mstyle scriptlevel="1"><mi>x</mi></mstyle>
                        <mo>=</mo>
                        <mn>1</mn>
                    </Math>
                    <Value> and a tall fraction </Value>
                    <Math display="yes"><mfrac><mfrac><mi>a</mi><mi>b</mi></mfrac><mi>c</mi></mfrac></Math>
                    <Value> in a paragraph with normal leading, followed by more text so that the line breaks and the next line is visible.</Value>
                </Paragraph>

                <Paragraph>
                    <Value>Second font family is ignored: </Value>
                    <Math fontfamily="display"><mi>x</mi></Math>
                </Paragraph>
            </Textblock>
        </PlaceObject>
    </Record>
</Layout>
