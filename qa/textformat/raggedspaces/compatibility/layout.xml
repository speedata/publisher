<Layout xmlns="urn:speedata.de:2009/publisher/en"
  xmlns:sd="urn:speedata:2009/publisher/functions/en">

  <Options crop="2mm"/>
  <!-- without defaults, the single option switches on the natural word spaces -->
  <Compatibility raggednaturalspaces="yes"/>

  <DefineTextformat name="left" alignment="leftaligned"/>
  <DefineTextformat name="right" alignment="rightaligned"/>
  <DefineTextformat name="center" alignment="centered"/>

  <Record element="data">
    <PlaceObject column="1" row="1">
      <Textblock width="75mm">
        <Paragraph textformat="left">
          <Value>The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog.</Value>
        </Paragraph>
        <Paragraph textformat="right">
          <Value>The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog.</Value>
        </Paragraph>
        <Paragraph textformat="center">
          <Value>The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog.</Value>
        </Paragraph>
      </Textblock>
    </PlaceObject>
  </Record>

</Layout>
