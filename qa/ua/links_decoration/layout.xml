<Layout xmlns="urn:speedata.de:2009/publisher/en" xmlns:sd="urn:speedata:2009/publisher/functions/en">
	<PDFOptions format="PDF/UA" title="Links and decoration" />
	<Trace dump-structtree="yes" />
	<Pageformat height="8cm" width="8cm" />
	<DefineTextformat name="center" alignment="centered" />

	<Record element="data">
		<PlaceObject column="1" row="1">
			<Textblock width="6">
				<!-- link with several children, the last one underlined at the end of the line -->
				<Paragraph textformat="center">
					<Value>Published by </Value>
					<A href="https://example.org"><U><Value>https://exam</Value></U><Value>p</Value><U><Value>le.org</Value></U></A>
					<Br />
					<Value>Next line</Value>
				</Paragraph>
				<!-- link over two lines -->
				<Paragraph>
					<Value>Visit </Value>
					<A href="https://example.org"><Value>this is a long link text that runs over two lines</Value></A>
					<Value> now.</Value>
				</Paragraph>
				<!-- leaders -->
				<Paragraph>
					<Value>Genesis </Value><HSpace leader="." /><Value>12</Value>
				</Paragraph>
				<!-- background color -->
				<Paragraph>
					<Value>Some </Value><Span background-color="lightgray"><Value>marked</Value></Span><Value> text.</Value>
				</Paragraph>
			</Textblock>
		</PlaceObject>
	</Record>
</Layout>
