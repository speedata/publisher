<Layout xmlns="urn:speedata.de:2009/publisher/en">
    <Pageformat height="8cm" width="10cm" />
    <Stylesheet>
        body { margin: 0; }
        table { width: 100%; margin-bottom: 10pt; }
        td, th { border: 1pt solid black; padding: 3pt; }
        .colored td { border-color: blue; }
        .thick td { border-width: 2pt; }
    </Stylesheet>

    <Record element="data">
        <Output>
            <HTML>
                <body>
                    <table>
                        <thead><tr><th>Header 1</th><th>Header 2</th></tr></thead>
                        <tbody>
                            <tr><td>Cell 1</td><td>Cell 2</td></tr>
                            <tr><td>Cell 3</td><td>Cell 4</td></tr>
                        </tbody>
                    </table>
                    <table class="colored">
                        <tbody>
                            <tr><td>Blue border</td><td>Blue border</td></tr>
                        </tbody>
                    </table>
                    <table class="thick">
                        <tbody>
                            <tr><td>Thick border</td><td>Thick border</td></tr>
                        </tbody>
                    </table>
                </body>
            </HTML>
        </Output>
    </Record>
</Layout>
