<Layout xmlns="urn:speedata.de:2009/publisher/en">
    <Pageformat height="14cm" width="10cm" />
    <Stylesheet>
        @font-face {
            font-family: dejavuserif;
            src: url("DejaVuSerif.ttf");
        }
        body { margin: 0; font-size: 9pt; font-family: dejavuserif;}
        ul, ol { margin: 5pt 0; }
        .disc { list-style-type: disc; }
        .circle { list-style-type: circle; }
        .square { list-style-type: square; }
        .none { list-style-type: none; }
        .decimal { list-style-type: decimal; }
        .decimal-lz { list-style-type: decimal-leading-zero; }
        .lower-alpha { list-style-type: lower-alpha; }
        .upper-alpha { list-style-type: upper-alpha; }
        .lower-roman { list-style-type: lower-roman; }
        .upper-roman { list-style-type: upper-roman; }
    </Stylesheet>

    <Record element="data">
        <Output>
            <HTML>
                <ul class="disc">
                    <li>disc</li>
                    <li>disc</li>
                </ul>
                <ul class="circle">
                    <li>circle</li>
                    <li>circle</li>
                </ul>
                <ul class="square">
                    <li>square</li>
                    <li>square</li>
                </ul>
                <ul class="none">
                    <li>none</li>
                    <li>none</li>
                </ul>
                <ol class="decimal">
                    <li>decimal</li>
                    <li>decimal</li>
                </ol>
                <ol class="decimal-lz">
                    <li>decimal-leading-zero</li>
                    <li>decimal-leading-zero</li>
                </ol>
                <ol class="lower-alpha">
                    <li>lower-alpha</li>
                    <li>lower-alpha</li>
                </ol>
                <ol class="upper-alpha">
                    <li>upper-alpha</li>
                    <li>upper-alpha</li>
                </ol>
                <ol class="lower-roman">
                    <li>lower-roman</li>
                    <li>lower-roman</li>
                </ol>
                <ol class="upper-roman">
                    <li>upper-roman</li>
                    <li>upper-roman</li>
                </ol>
            </HTML>
        </Output>
    </Record>
</Layout>
