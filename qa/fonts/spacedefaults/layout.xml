<Layout xmlns="urn:speedata.de:2009/publisher/en"
  xmlns:sd="urn:speedata:2009/publisher/functions/en"
  defaults="6.0">

  <Options crop="2mm"/>

  <!-- defaults="6.0" enables spacefromfont, no Compatibility element needed -->
  <LoadFontfile name="fromfont" filename="texgyreheros-regular.otf" />
  <!-- explicit space attribute wins over the defaults level -->
  <LoadFontfile name="pinned" filename="texgyreheros-regular.otf" space="25" />

  <DefineFontfamily name="fromfont" fontsize="10" leading="12">
    <Regular fontface="fromfont"/>
  </DefineFontfamily>

  <DefineFontfamily name="pinned" fontsize="10" leading="12">
    <Regular fontface="pinned"/>
  </DefineFontfamily>

  <Record element="data">
    <PlaceObject>
      <Textblock width="5">
        <Paragraph fontfamily="fromfont">
          <Value>The interword space of this paragraph comes from the font itself and the text breaks into lines accordingly.</Value>
        </Paragraph>
        <Paragraph fontfamily="pinned">
          <Value>The interword space of this paragraph comes from the font itself and the text breaks into lines accordingly.</Value>
        </Paragraph>
      </Textblock>
    </PlaceObject>
  </Record>

</Layout>
