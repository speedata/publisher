<Layout xmlns="urn:speedata.de:2009/publisher/en"
  xmlns:sd="urn:speedata:2009/publisher/functions/en"
  defaults="6.0">

  <Options crop="2mm"/>
  <!-- the single option pulls the behavior back to the old state -->
  <Compatibility spacefromfont="no"/>

  <LoadFontfile name="fromfont" filename="texgyreheros-regular.otf" />

  <DefineFontfamily name="fromfont" fontsize="10" leading="12">
    <Regular fontface="fromfont"/>
  </DefineFontfamily>

  <Record element="data">
    <PlaceObject>
      <Textblock width="5">
        <Paragraph fontfamily="fromfont">
          <Value>The interword space of this paragraph keeps the old fixed width of 25 percent of the font size.</Value>
        </Paragraph>
      </Textblock>
    </PlaceObject>
  </Record>

</Layout>
