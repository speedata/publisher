<?xml version="1.0" encoding="UTF-8"?>
<Layout
  xmlns="urn:speedata.de:2009/publisher/en"
  xmlns:sd="urn:speedata:2009/publisher/functions/en">

  <Record element="data">
    <PlaceObject>
      <Textblock>
        <Paragraph><Value select="string-join((chap/title | chap/num), '-')"/></Paragraph>
        <Paragraph><Value select="count(foo | bar | foo)"/></Paragraph>
        <Paragraph><Value select="count((foo | bar) intersect foo)"/></Paragraph>
        <Paragraph><Value select="count((foo | bar) except foo)"/></Paragraph>
      </Textblock>
    </PlaceObject>
    <ProcessNode select="foo | bar"/>
  </Record>

  <Record element="foo">
    <PlaceObject>
      <Textblock>
        <Paragraph><Value>foo </Value><Value select="@id"/></Paragraph>
      </Textblock>
    </PlaceObject>
  </Record>

  <Record element="bar">
    <PlaceObject>
      <Textblock>
        <Paragraph><Value>bar </Value><Value select="@id"/></Paragraph>
      </Textblock>
    </PlaceObject>
  </Record>
</Layout>
