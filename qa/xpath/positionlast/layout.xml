<Layout xmlns="urn:speedata.de:2009/publisher/en"
    xmlns:sd="urn:speedata:2009/publisher/functions/en">
    <Pageformat height="5cm" width="6cm"></Pageformat>

    <Record element="data">
        <ProcessNode select="*"/>
    </Record>

    <Record element="a">
        <ForAll select="sub"></ForAll>
        <PlaceObject>
            <Textblock>
                <Paragraph>
                    <Value select="concat(position(),'/',last()) " />
                </Paragraph>
            </Textblock>
        </PlaceObject>
    </Record>

</Layout>