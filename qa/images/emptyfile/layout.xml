		<PlaceObject>
			<Image file="empty1.png" width="4cm" />
		</PlaceObject>
		<PlaceObject>
			<Image file="empty2.png" width="4cm" fallback="_samplea.pdf" />
		</PlaceObject>
	</Record>
</Layout>
